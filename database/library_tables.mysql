SELECT * FROM Authors;
SELECT * FROM Categories;
SELECT * FROM Readers;
SELECT * FROM Books;
SELECT * FROM Loans;
SELECT
  L.loanID,
  B.title,
  A.name AS author,
  R.fullname AS reader,
  L.loan_date,
  L.return_date
FROM Loans l
JOIN Books b ON b.bookID = l.bookID
JOIN Authors a ON a.authorID = b.authorID
JOIN Readers r ON r.readerID = l.readerID;
 

